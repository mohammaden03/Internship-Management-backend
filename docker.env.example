# Copy to `.env` next to docker-compose.yml, then replace the two secrets.
# Generate each one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex_refresh_secret

# Host ports (the container ports never change).
FRONTEND_PORT=3000
BACKEND_PORT=3010
POSTGRES_PORT=5432

# Database credentials used by both the postgres container and the API.
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=internship_pass_secure
POSTGRES_DB=internship_db

# Demo data: the seed runs only when the database is empty.
AUTO_SEED=true
SEED_DEFAULT_PASSWORD=Password123@

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:5173
