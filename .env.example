# ==============================================================================
# University Internship Management System - Environment Configuration
# Copy this file to .env and adjust secrets before running in production.
# ==============================================================================

# Server Configuration
PORT=3000
API_PREFIX=api
APP_NAME="University Internship Management System API"
APP_DESCRIPTION="سامانه جامع مدیریت کارآموزی دانشگاه"

# PostgreSQL Database Configuration
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=internship_db
DATABASE_URL="postgresql://internship_user:change_me_db_password@localhost:5432/internship_db?schema=public"

# JWT Authentication Secrets (replace with strong random strings in production)
JWT_SECRET=change_me_jwt_secret_key
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# File Upload Configuration
UPLOAD_DESTINATION=./uploads/documents
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png

# Docker Auto-Seeding (seeds initial Persian data only when the users table is empty)
AUTO_SEED=true