datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
}

enum InternshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum DocumentType {
  INTRODUCTION_LETTER
  CONTRACT
  START_FORM
  FINAL_REPORT
  OTHER
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String               @unique
  nationalCode        String               @unique
  password            String
  phoneNumber         String?
  role                Role                 @default(STUDENT)
  isActive            Boolean              @default(true)
  refreshToken        String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  student             Student?
  professor           Professor?
  notifications       Notification[]
  activityLogs        ActivityLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId       String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Student {
  id            Int                 @id @default(autoincrement())
  studentNumber String              @unique
  faculty       String
  major         String
  degreeLevel   String
  userId        Int                 @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  requests      InternshipRequest[]
  internships   Internship[]

  @@map("students")
}

model Professor {
  id           Int                 @id @default(autoincrement())
  department   String
  academicRank String
  userId       Int                 @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  requests     InternshipRequest[]
  internships  Internship[]

  @@map("professors")
}

model Company {
  id              Int                 @id @default(autoincrement())
  name            String
  industry        String
  city            String
  address         String
  phone           String
  supervisorName  String
  supervisorPhone String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requests        InternshipRequest[]
  internships     Internship[]

  @@map("companies")
}

model InternshipRequest {
  id              Int           @id @default(autoincrement())
  studentId       Int
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  professorId     Int?
  professor       Professor?    @relation(fields: [professorId], references: [id], onDelete: SetNull)
  academicTerm    String        @default("تابستان ۱۴۰۳")
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  totalHours      Int           @default(240)
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  internship      Internship?

  @@index([deletedAt])
  @@index([studentId, companyId, academicTerm])
  @@map("internship_requests")
}

model Internship {
  id                 Int               @id @default(autoincrement())
  studentId          Int
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professorId        Int
  professor          Professor         @relation(fields: [professorId], references: [id], onDelete: Restrict)
  companyId          Int
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestId          Int               @unique
  request            InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  academicTerm       String            @default("تابستان ۱۴۰۳")
  startDate          DateTime
  endDate            DateTime
  progressPercentage Int               @default(0)
  status             InternshipStatus  @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  weeklyReports      WeeklyReport[]
  documents          Document[]
  evaluation         Evaluation?

  @@index([deletedAt])
  @@index([studentId, academicTerm, status])
  @@map("internships")
}

model WeeklyReport {
  id               Int          @id @default(autoincrement())
  internshipId     Int
  internship       Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  weekNumber       Int
  startDate        DateTime
  endDate          DateTime
  activities       String
  skillsLearned    String
  challenges       String?
  description      String
  status           ReportStatus @default(DRAFT)
  professorComment String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([internshipId, weekNumber])
  @@map("weekly_reports")
}

model Document {
  id           Int          @id @default(autoincrement())
  internshipId Int
  internship   Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String       @default("")
  filePath     String
  storageKey   String?
  mimeType     String       @default("application/pdf")
  size         Int          @default(0)
  sha256       String?
  documentType DocumentType
  deletedAt    DateTime?
  uploadedAt   DateTime     @default(now())

  @@index([deletedAt])
  @@index([internshipId, sha256])
  @@map("documents")
}

model Evaluation {
  id             Int        @id @default(autoincrement())
  internshipId   Int        @unique
  internship     Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  technicalSkill Float
  responsibility Float
  discipline     Float
  teamwork       Float
  attendance     Float
  description    String
  finalScore     Float
  createdAt      DateTime   @default(now())

  @@map("evaluations")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  event      String
  entityType String?
  entityId   String?
  ip         String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([event])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
