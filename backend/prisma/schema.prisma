datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
}

enum InternshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DocumentType {
  INTRODUCTION_LETTER
  CONTRACT
  START_FORM
  FINAL_REPORT
  OTHER
}

model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String        @unique
  nationalCode String        @unique
  password     String
  phoneNumber  String?
  role         Role          @default(STUDENT)
  isActive     Boolean       @default(true)
  refreshToken String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student      Student?
  professor    Professor?
  notifications Notification[]
  activityLogs ActivityLog[]

  @@map("users")
}

model Student {
  id            Int                 @id @default(autoincrement())
  studentNumber String              @unique
  faculty       String
  major         String
  degreeLevel   String
  userId        Int                 @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  requests      InternshipRequest[]
  internships   Internship[]

  @@map("students")
}

model Professor {
  id           Int           @id @default(autoincrement())
  department   String
  academicRank String
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  internships  Internship[]

  @@map("professors")
}

model Company {
  id              Int                 @id @default(autoincrement())
  name            String
  industry        String
  city            String
  address         String
  phone           String
  supervisorName  String
  supervisorPhone String
  createdAt       DateTime            @default(now())

  requests        InternshipRequest[]
  internships     Internship[]

  @@map("companies")
}

model InternshipRequest {
  id          Int            @id @default(autoincrement())
  studentId   Int
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  totalHours  Int            @default(240)
  status      RequestStatus  @default(PENDING)
  createdAt   DateTime       @default(now())

  internship  Internship?

  @@map("internship_requests")
}

model Internship {
  id                 Int              @id @default(autoincrement())
  studentId          Int
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professorId        Int
  professor          Professor        @relation(fields: [professorId], references: [id], onDelete: Restrict)
  companyId          Int
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestId          Int              @unique
  request            InternshipRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  startDate          DateTime
  endDate            DateTime
  progressPercentage Int              @default(0)
  status             InternshipStatus @default(ACTIVE)

  weeklyReports      WeeklyReport[]
  documents          Document[]
  evaluation         Evaluation?

  @@map("internships")
}

model WeeklyReport {
  id               Int          @id @default(autoincrement())
  internshipId     Int
  internship       Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  weekNumber       Int
  startDate        DateTime
  endDate          DateTime
  activities       String
  skillsLearned    String
  challenges       String?
  description      String
  status           ReportStatus @default(DRAFT)
  professorComment String?
  createdAt        DateTime     @default(now())

  @@unique([internshipId, weekNumber])
  @@map("weekly_reports")
}

model Document {
  id           Int          @id @default(autoincrement())
  internshipId Int
  internship   Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  documentType DocumentType
  uploadedAt   DateTime     @default(now())

  @@map("documents")
}

model Evaluation {
  id              Int        @id @default(autoincrement())
  internshipId    Int        @unique
  internship      Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  technicalSkill  Float
  responsibility  Float
  discipline      Float
  teamwork        Float
  attendance      Float
  description     String
  finalScore      Float
  createdAt       DateTime   @default(now())

  @@map("evaluations")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
