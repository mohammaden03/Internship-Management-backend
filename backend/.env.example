# Environment Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL & Prisma ORM
DATABASE_URL="postgresql://internship_user:internship_pass_secure@localhost:5432/internship_db?schema=public"
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=internship_pass_secure
POSTGRES_DB=internship_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_university_internship_2026
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_refresh_jwt_key_university_internship_2026
JWT_REFRESH_EXPIRATION=7d

# File Upload Configuration (Multer)
UPLOAD_DESTINATION=./uploads/documents
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png

# App Metadata
APP_NAME="University Internship Management Backend"
APP_DESCRIPTION="Production-ready NestJS Backend for University Internship Management"
API_PREFIX=api
