# ==============================================================================
# University Internship Management Backend - Environment Configuration
# Copy this file to backend/.env before running locally or via Docker Compose.
# ==============================================================================

# Server Configuration (standardized on port 3010)
NODE_ENV=development
PORT=3010
API_PREFIX=api
LOG_LEVEL=log
APP_NAME="University Internship Management System API"
APP_DESCRIPTION="سامانه جامع مدیریت کارآموزی دانشگاه"

# PostgreSQL Database Configuration
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=internship_db
DATABASE_URL="postgresql://internship_user:replace_with_strong_db_password@localhost:5432/internship_db?schema=public"

# JWT Authentication Secrets (REQUIRED: minimum 32 chars each, must be distinct)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_replace_with_64_char_random_hex_access_token_secret_0001
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=dev_only_replace_with_64_char_random_hex_refresh_token_secret_0002
JWT_REFRESH_EXPIRATION=7d

# CORS & Frontend Origin (comma-separated allowlist; wildcard '*' forbidden in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# File Upload Configuration (served ONLY via authenticated GET /api/documents/download/:id)
UPLOAD_DESTINATION=./uploads/documents
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Email / Password Reset (optional in dev; configure SMTP_URL in production)
# Example: smtp://user:pass@smtp.university.ac.ir:587
SMTP_URL=
SMTP_FROM="University Internship Office <no-reply@semnan.ac.ir>"
PASSWORD_RESET_TTL_MINUTES=60

# Database Seeding (required if running prisma:seed in production)
SEED_DEFAULT_PASSWORD=Password123@
AUTO_SEED=false

# Optional Observability (disabled when empty)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
